#!/bin/bash


#Useful  functions 
function pull() {
    status=pulled
    if [ "$check" = true ]; then 
        return 0 
    fi

    if [ "$use_local" = true ]; then
        if [ "$#" -gt 0 ]; then
          local repo_name=$1 
          echo "repo ${repo_name} is behind local bare, pulling..."  
        fi
        git pull bare main --quiet  || status=pull_failed
        return 0
    fi

    if [ "$#" -gt 0 ]; then
        local repo_name=$1 
        echo "repo ${repo_name} is behind origin, pulling..."  
    fi
    git pull origin main --quiet  || status=pull_failed
}

function commit() {
    git add --all > /dev/null
    if [ -z "$commit_message" ]; then
        git commit -m "auto-sync" > /dev/null || echo "commit failed :("
    else
        git commit -m "${commit_message}" > /dev/null || echo "commit failed :("
    fi
}

function push() {
    status=pushed
    if [ "$check" = true ]; then 
        return 0 
    fi

    if [ "$use_local" = true ]; then
        if [ "$#" -gt 0 ]; then
            local repo_name=$1
            echo "repo ${repo_name} is ahead of local bare, pushing..."     
        fi
        git push bare main --quiet || status=push_failed
        return 0
    fi

    if [ "$#" -gt 0 ]; then
        local repo_name=$1
        echo "repo ${repo_name} is ahead of origin, pushing..."     
    fi
    git push origin main --quiet || status=push_failed
}

function fetch() {

    if [ "$use_local" = true ]; then
        git fetch bare main --quiet
        return 0
    fi

    git fetch origin --quiet
}

usage() {
  echo "Usage: $(basename $0) [COMMIT MESSAGE] [OPTIONS] "
  echo
  echo "Options:"
  echo "  -c, --check                Check what needs to be done but dont actually commit or push/pull"
  echo "  -e, --exclude FILES...     Exclude FILES from this push"
  echo "  -h, --help                 Display this help message and exit"
  echo "  -p, --permanently-exclude  Permanently exclude FILES from future pushes"
  echo "  -l, --local                Commit to a local bare repo instead of main, must be called bare"
  echo
  exit 0
}


# Use `getopt` to handle both short and long options 
TEMP=$(getopt -o cp:he:l --long check,permanently-exclude:,help,exclude:,local -n 'scriptname' -- "$@")
if [ $? != 0 ]; then usage; exit 1; fi

eval set -- "$TEMP"

# Parse the options
check=false
use_local=false
excluding_files=()
permanent_exclude=false
while true; do
  case "$1" in
    -c|--check)
      check=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    -l|--local)
      use_local=true
      shift
      ;;
    -e|--exclude)
      # Gather files to exclude
      shift
      while [ $# -gt 0 ]; do
        if [[ $1 == -* ]]; then
          break
        fi
        excluding_files+=("$1")
        shift
      done
      ;;
    -p|--permanently-exclude)
      # Gather files to permanently exclude
      permanent_exclude=true
      shift
      while [ $# -gt 0 ]; do
        if [[ $1 == -* ]]; then
          break
        fi
        excluding_files+=("$1")
        shift
      done
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "Invalid option"
      usage
      exit 1
      ;;
  esac
done


# Warning checks before starting script 
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "Warning: you are not in a git repo directory"
    exit 1
elif [ "$use_local" = true ]; then
    if ! git remote | grep -qx "bare"; then
        echo "Warning you need to set a bare repo before syncing locally"
        exit 1
    fi
fi

# Checking where we should be committing
# Auto use the local bare repo if one is configured
if [ "$use_local" != true ] && git remote | grep -qx "bare"; then
    use_local=true
fi



# If origin is https, switch it to ssh once so pushes don't ask for a password.
# ssh/bare remotes are left untouched.
if [ "$check" != true ] && [ "$use_local" != true ]; then
    url=$(git remote get-url origin 2>/dev/null)
    if [[ "$url" == https://* ]]; then
        rest=${url#https://}     # github.com/you/repo.git
        rest=${rest#*@}          # drop any user/token baked into the url
        git remote set-url origin "ssh://git@${rest}"
        echo "origin was https, switched to ssh://git@${rest}"
    fi
fi


#Starting script
dir=$(git rev-parse --show-toplevel)    #directory of top directory in the git repo tree
repo_name=$(basename "$(git remote get-url origin || git remote get-url bare 2>/dev/null)" .git)

#see if there are files to exclude from adding 
added_files=()
if [ ${#excluding_files[@]} -ne 0 ]; then
    [ -f "$dir/.gitignore" ] || touch "$dir/.gitignore"
    for file in "${excluding_files[@]}"; do
        if [ -n "$file" ] && [ -f "$file" ]; then
            if grep -qxF "$file" "$dir/.gitignore"; then
                echo "$file already in .gitignore"
            elif [ "$check" = true ]; then
                echo "would ignore $file"
            else
                git rm --cached "$file" > /dev/null 2>&1
                echo "$file" >> "$dir/.gitignore"
                added_files+=("$file")
                echo "ignoring $file"
            fi
        fi
    done
fi

#check if there is a commit message
commit_message=""
if [ "$#" -gt 0 ]; then
    commit_message="$*"
fi


remote_branch=origin/main
if [ "$use_local" = true ]; then remote_branch=bare/main; fi
#Fetch origin to compare 
fetch

# Commit if there is something to commit and we are not just checking
dirty=false  # dirty means something happened 
if [ -n "$(git status --porcelain)" ]; then dirty=true; fi
if [ "$dirty" = true ] && [ "$check" != true ]; then
    commit
fi

behind=$(git rev-list --count HEAD..$remote_branch 2>/dev/null || echo 0)  #Count how many changes behind origin/base we are
ahead=$(git rev-list --count $remote_branch..HEAD 2>/dev/null || echo 0) #Count how many changes ahead of origin/base we are



if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
    status=merger_issue
elif [ "$behind" -gt 0 ]; then
    pull "$repo_name"
elif [ "$ahead" -gt 0 ] || [ "$dirty" = true ]; then
    push "$repo_name"
else
    status=up_to_date
fi


#If we are only temporarily are exliding files then remove them from .gitignore
if [ "$permanent_exclude" != true ]  && [ "$check" != true ]; then
    for file in "${added_files[@]}"; do
        grep -vxF "$file" "$dir/.gitignore" > "$dir/.gitignore.tmp"
        mv "$dir/.gitignore.tmp" "$dir/.gitignore"
    done
fi



#echo what has happened :)
if [ "${status}" = "up_to_date" ]; then
    echo "No updates needed :)"      
elif [ "$status" = "merger_issue" ]; then
    echo "Uh oh seems there is a merger issue :("
elif [ "$status" = "pull_failed" ]; then
    echo "Pull failed :("
elif [ "$status" = "push_failed" ]; then
    echo "Push failed :("
else
    if [ "$check" = true ]; then
        if [ "$status" = "pulled" ]; then
            echo "repo ${repo_name} is behind origin, need to pull"
        elif [ "$status" = "pushed" ]; then
            if [ "$dirty" = true ]; then
                echo "repo ${repo_name} has changes, need to commit and push"
            else
                echo "repo ${repo_name} is ahead $remote_branch, need to push"
            fi
        fi
    else
        echo "All done!"
    fi    
fi

# Try fix merger issue if wanted
if [ "$status" = "merger_issue" ] && [ "$check" != true ]; then
    current_branch=$(echo "$(git --no-pager branch)" | awk -F '*' '{print $NF}')
    origin_branch=$(git --no-pager branch -a | grep '\->' | awk -F 'HEAD ->' '{print $NF}')

    diff_list=$(git --no-pager diff --name-status ${current_branch} ${origin_branch}| grep -w 'M' | awk -F ' ' '{print $NF}' )
    echo "The following files are divergent between local branch and origin:"
    echo "${diff_list}"

    read -p "Do you want to attempt basic merger? (Y/n) " response
    if [ "$response" = "n" ] || [ "$response" = "N" ]; then 
        exit 1
    fi

    git pull --no-rebase --no-edit $remote_branch --quiet
    if [ $? -ne 0 ]; then
        git diff --name-only --diff-filter=U
        echo "Merge unsuccesfull :(" 
    else
        push
        echo "Merge succsessful!"
    fi 
fi

